new file mode 100644
index 0000000..829f5d6
--- /dev/null
+++ b/src/request_clock.bend
@@ -0,0 +1,11 @@
+import Base
+
+# Diagnostic boundaries for a serial request. The deltas between successive
+# timestamps partition the existing request timer, including logging overhead.
+def at(name: String,ms: Nat) -> IO(Unit):
+  IO.print_err("request-clock " ++ name ++ " " ++ Nat.show(ms))
+
+def mark(name: String) -> IO(Unit):
+  do IO<Unit>:
+    n : Nat <- IO.now()
+    at(name,n)
