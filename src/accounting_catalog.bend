# Configuration-only dyadic error bounds from scripts/plan-profiles.py.
import Base
import ./plan_types.bend as P

type Bound is Data:
  Bound{work: Nat, denominator_bits: Nat, numerator: List<&2,U32>}

type Stage is Data:
  Stage{target: Nat, rounds: Nat, by_work: Nat, third: Nat, theorem: Nat, errors: List<&2,Bound>}

def smallexact() -> List<&2,Stage>:
  [Stage{128n,3737n,14n,0n,37n,[Bound{0n,320n,[2657575885, 3525935474, 3035538605, 3704750955, 2234460898, 4291678702]},Bound{32n,288n,[1690425272, 142601552, 2493753646, 2977490357, 365449313, 3645834899]}]},
   Stage{128n,25n,4n,0n,12n,[Bound{0n,320n,[1815329562, 1129276268, 1606072044, 593516699, 3243142676, 4287602755]},Bound{32n,288n,[1788273650, 2260320869, 4034221198, 1096152348, 1407129312, 3024662205]}]},
   Stage{128n,8095n,20n,0n,78n,[Bound{0n,128n,[1]},Bound{20n,300n,[227344970, 1976258933, 1470120273, 1137431860, 2848822644, 3919099007]},Bound{28n,292n,[3585911032, 1431291637, 877158993, 2875109247, 4152492427, 3976450688]}]}]

def smallclipped() -> List<&2,Stage>:
  [Stage{128n,3737n,14n,0n,37n,[Bound{0n,320n,[2657575885, 3525935474, 3035538605, 3704750955, 2234460898, 4291678702]},Bound{32n,288n,[1690425272, 142601552, 2493753646, 2977490357, 365449313, 3645834899]}]},
   Stage{128n,25n,4n,0n,12n,[Bound{0n,320n,[1815329562, 1129276268, 1606072044, 593516699, 3243142676, 4287602755]},Bound{32n,288n,[1788273650, 2260320869, 4034221198, 1096152348, 1407129312, 3024662205]}]},
   Stage{128n,8095n,20n,0n,78n,[Bound{0n,128n,[1]},Bound{20n,300n,[227344970, 1976258933, 1470120273, 1137431860, 2848822644, 3919099007]},Bound{28n,292n,[3585911032, 1431291637, 877158993, 2875109247, 4152492427, 3976450688]}]}]

def fullexact() -> List<&2,Stage>:
  [Stage{128n,18950n,19n,0n,63n,[Bound{0n,320n,[2657575885, 3525935474, 3035538605, 3704750955, 2234460898, 4291678702]},Bound{32n,288n,[4002356650, 3591987458, 1973193251, 2469158476, 217991389, 3657994344]}]},
   Stage{128n,42n,6n,0n,23n,[Bound{0n,320n,[1914244156, 3937389720, 1757135358, 862385879, 3178614273, 4288028774]},Bound{32n,288n,[4002326282, 3592033010, 1973238803, 2469173660, 217991389, 3657994344]}]},
   Stage{128n,48391n,46n,0n,255n,[Bound{0n,128n,[1]},Bound{20n,300n,[3056966281, 4120678133, 701289586, 3496426946, 2532089251, 3563027933]},Bound{28n,292n,[3961068953, 154105294, 1557708371, 222810278, 1432182918, 4018911257]}]}]

def fullclipped() -> List<&2,Stage>:
  [Stage{128n,18950n,19n,0n,63n,[Bound{0n,320n,[2657575885, 3525935474, 3035538605, 3704750955, 2234460898, 4291678702]},Bound{32n,288n,[4002356650, 3591987458, 1973193251, 2469158476, 217991389, 3657994344]}]},
   Stage{128n,42n,6n,0n,23n,[Bound{0n,320n,[1914244156, 3937389720, 1757135358, 862385879, 3178614273, 4288028774]},Bound{32n,288n,[4002326282, 3592033010, 1973238803, 2469173660, 217991389, 3657994344]}]},
   Stage{128n,48391n,46n,0n,255n,[Bound{0n,128n,[1]},Bound{20n,300n,[3056966281, 4120678133, 701289586, 3496426946, 2532089251, 3563027933]},Bound{28n,292n,[3961068953, 154105294, 1557708371, 222810278, 1432182918, 4018911257]}]}]

def stages(profile: P.Profile) -> List<&2,Stage>:
  match profile:
    case P.SmallExact{}: smallexact()
    case P.SmallClipped{}: smallclipped()
    case P.FullExact{}: fullexact()
    case P.FullClipped{}: fullclipped()

type Report is Data:
  Report{work: String, rounds: String, least: String, bare: String, theorem: String}

def report(profile: P.Profile) -> Report:
  match profile:
    case P.SmallExact{}: Report{"32","38","128.00","96.23","49"}
    case P.SmallClipped{}: Report{"32","38","128.00","96.23","49"}
    case P.FullExact{}: Report{"32","71","128.00","96.23","86"}
    case P.FullClipped{}: Report{"32","71","128.00","96.23","86"}
