# Generated by scripts/key-geometry.py from configuration-only H821 plans.
import Base
import ./plan_types.bend as P

type Target is Data:
  Table{}
  Local{place: Nat}

type Tree is Data:
  Tree{target: Target, depth: Nat, width: Nat, salt: Nat}

def Schedule() -> Data:
  List<&2,List<&2,Tree>>

def small(chain: P.Chain) -> Schedule:
  match chain:
    case P.KeyOnce{}:
      [[Tree{Local{1n},22n,46n,40n}],
       [Tree{Local{2n},19n,96n,40n}],
       [Tree{Local{3n},17n,72n,40n}],
       [Tree{Local{4n},20n,12n,40n}]]
    case P.KeyShared{}:
      [[Tree{Table{},23n,256n,40n}],
       [Tree{Local{0n},17n,57n,40n},Tree{Local{2n},13n,3n,40n}],
       [Tree{Local{3n},14n,72n,40n}],
       [Tree{Local{4n},14n,12n,40n}],
       [Tree{Local{1n},18n,12n,40n},Tree{Local{2n},13n,3n,40n},Tree{Local{5n},13n,3n,40n}],
       [Tree{Local{6n},14n,96n,40n}],
       [Tree{Local{7n},15n,12n,40n}]]
    case P.KeySecond{}:
      [[Tree{Local{0n},13n,3n,40n},Tree{Local{5n},18n,6n,40n},Tree{Local{6n},18n,12n,40n}],
       [Tree{Local{7n},14n,96n,40n}],
       [Tree{Local{8n},15n,12n,40n}]]
    case _: []

def full(chain: P.Chain) -> Schedule:
  match chain:
    case P.KeyOnce{}:
      [[Tree{Local{1n},22n,77n,40n}],
       [Tree{Local{2n},19n,96n,40n}],
       [Tree{Local{3n},17n,72n,40n}],
       [Tree{Local{4n},20n,12n,40n}]]
    case P.KeyShared{}:
      [[Tree{Table{},32n,2048n,40n}],
       [Tree{Local{0n},24n,324n,40n},Tree{Local{2n},13n,3n,40n}],
       [Tree{Local{3n},21n,120n,40n}],
       [Tree{Local{4n},17n,72n,40n}],
       [Tree{Local{5n},13n,72n,40n}],
       [Tree{Local{6n},14n,12n,40n}],
       [Tree{Local{1n},22n,36n,40n},Tree{Local{2n},13n,3n,40n},Tree{Local{7n},13n,3n,40n}],
       [Tree{Local{8n},18n,96n,40n}],
       [Tree{Local{9n},14n,96n,40n}],
       [Tree{Local{10n},15n,12n,40n}]]
    case P.KeySecond{}:
      [[Tree{Local{0n},13n,3n,40n},Tree{Local{5n},22n,12n,40n},Tree{Local{6n},22n,36n,40n}],
       [Tree{Local{7n},18n,96n,40n}],
       [Tree{Local{8n},15n,72n,40n}],
       [Tree{Local{9n},13n,72n,40n}],
       [Tree{Local{10n},15n,12n,40n}]]
    case _: []

def schedule(profile: P.Profile, chain: P.Chain) -> Schedule:
  match profile:
    case P.SmallExact{}: small(chain)
    case P.SmallClipped{}: small(chain)
    case P.FullExact{}: full(chain)
    case P.FullClipped{}: full(chain)
