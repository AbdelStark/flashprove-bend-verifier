def shape(lt: Nat, first: Bool) -> IO(G.Shape):
  match lt first:
    case 6n True{}: IO.pure(G.Shape,small_first())
    case 6n False{}: IO.pure(G.Shape,small_later())
    case 10n True{}: IO.pure(G.Shape,full_first())
    case 10n False{}: IO.pure(G.Shape,full_later())
    case _ _: IO.die(G.Shape,1,"NO: feed-forward-profile")
