import Base

type G4 is Data:
  G4{ah: U32, al: U32, bh: U32, bl: U32, ch: U32, cl: U32, dh: U32, dl: U32}

type V16 is Data:
  V16{v0h: U32, v0l: U32, v1h: U32, v1l: U32, v2h: U32, v2l: U32, v3h: U32, v3l: U32, v4h: U32, v4l: U32, v5h: U32, v5l: U32, v6h: U32, v6l: U32, v7h: U32, v7l: U32, v8h: U32, v8l: U32, v9h: U32, v9l: U32, v10h: U32, v10l: U32, v11h: U32, v11l: U32, v12h: U32, v12l: U32, v13h: U32, v13l: U32, v14h: U32, v14l: U32, v15h: U32, v15l: U32}

type H8 is Data:
  H8{h0h: U32, h0l: U32, h1h: U32, h1l: U32, h2h: U32, h2l: U32, h3h: U32, h3l: U32, h4h: U32, h4l: U32, h5h: U32, h5l: U32, h6h: U32, h6l: U32, h7h: U32, h7l: U32}

# carry out of a 32-bit add s = a + b, branch-free
def carry(+a: U32, +b: U32, +s: U32) -> U32:
  U32.shrn(U32.or(U32.and(a, b), U32.and(U32.or(a, b), U32.not(s))), 31n)

def B2b.g(+ah: U32, +al: U32, +bh: U32, +bl: U32, +ch: U32, +cl: U32, +dh: U32, +dl: U32, +xh: U32, +xl: U32, +yh: U32, +yl: U32) -> G4:
  +s0l = U32.add(al, bl)
  +s0h = U32.add(U32.add(ah, bh), carry(al, bl, s0l))
  +a1l = U32.add(s0l, xl)
  +a1h = U32.add(U32.add(s0h, xh), carry(s0l, xl, a1l))
  +d1h = U32.xor(dl, a1l)
  +d1l = U32.xor(dh, a1h)
  +c1l = U32.add(cl, d1l)
  +c1h = U32.add(U32.add(ch, d1h), carry(cl, d1l, c1l))
  +e1h = U32.xor(bh, c1h)
  +e1l = U32.xor(bl, c1l)
  +b1h = U32.or(U32.shrn(e1h, 24n), U32.shln(e1l, 8n))
  +b1l = U32.or(U32.shrn(e1l, 24n), U32.shln(e1h, 8n))
  +s2l = U32.add(a1l, b1l)
  +s2h = U32.add(U32.add(a1h, b1h), carry(a1l, b1l, s2l))
  +a2l = U32.add(s2l, yl)
  +a2h = U32.add(U32.add(s2h, yh), carry(s2l, yl, a2l))
  +f1h = U32.xor(d1h, a2h)
  +f1l = U32.xor(d1l, a2l)
  +d2h = U32.or(U32.shrn(f1h, 16n), U32.shln(f1l, 16n))
  +d2l = U32.or(U32.shrn(f1l, 16n), U32.shln(f1h, 16n))
  +c2l = U32.add(c1l, d2l)
  +c2h = U32.add(U32.add(c1h, d2h), carry(c1l, d2l, c2l))
  +g1h = U32.xor(b1h, c2h)
  +g1l = U32.xor(b1l, c2l)
  +b2h = U32.or(U32.shln(g1h, 1n), U32.shrn(g1l, 31n))
  +b2l = U32.or(U32.shln(g1l, 1n), U32.shrn(g1h, 31n))
  G4{a2h, a2l, b2h, b2l, c2h, c2l, d2h, d2l}

def B2b.round.s8(r: G4, +w5_0h: U32, +w5_0l: U32, +w6_1h: U32, +w6_1l: U32, +w7_2h: U32, +w7_2l: U32, +w5_5h: U32, +w5_5l: U32, +w6_6h: U32, +w6_6l: U32, +w7_7h: U32, +w7_7l: U32, +w7_8h: U32, +w7_8l: U32, +w5_10h: U32, +w5_10l: U32, +w6_11h: U32, +w6_11l: U32, +w6_12h: U32, +w6_12l: U32, +w7_13h: U32, +w7_13l: U32, +w5_15h: U32, +w5_15l: U32) -> V16:
  G4{+w8_3h, +w8_3l, +w8_4h, +w8_4l, +w8_9h, +w8_9l, +w8_14h, +w8_14l} = r
  V16{w5_0h, w5_0l, w6_1h, w6_1l, w7_2h, w7_2l, w8_3h, w8_3l, w8_4h, w8_4l, w5_5h, w5_5l, w6_6h, w6_6l, w7_7h, w7_7l, w7_8h, w7_8l, w8_9h, w8_9l, w5_10h, w5_10l, w6_11h, w6_11l, w6_12h, w6_12l, w7_13h, w7_13l, w8_14h, w8_14l, w5_15h, w5_15l}

